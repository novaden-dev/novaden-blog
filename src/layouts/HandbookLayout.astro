---
import type { MarkdownHeading } from "astro";
import Layout from "@/layouts/Layout.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import HandbookTree from "@/components/HandbookTree.astro";
import type { HandbookConfig, TreeNode } from "@/utils/handbook";
import { SITE } from "@/config";

// The generic handbook documentation shell. It reuses Layout (head, fonts,
// theme, client router) but replaces the blog chrome with a three-pane app:
// a persistent navigation tree, the current chapter, and an optional outline.
// It is handed a handbook config and knows nothing about any specific handbook.
// The tree carries `transition:persist`, so moving between chapters keeps the
// same tree DOM, and with it the scroll position and open/closed folders.

type Crumb = { label: string; href?: string };

type Props = {
  handbook: HandbookConfig;
  title: string;
  description?: string;
  crumbs?: Crumb[];
  tree: TreeNode[];
  headings?: MarkdownHeading[];
};

const {
  handbook,
  title,
  description,
  crumbs = [],
  tree,
  headings = [],
} = Astro.props;

const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
const hasToc = tocHeadings.length > 1;
const navHeading = handbook.navHeading ?? handbook.title;
---

<Layout title={`${title} | ${SITE.title}`} description={description}>
  <div class="handbook" data-handbook-shell>
    <header class="handbook-bar">
      <button
        class="handbook-menu"
        type="button"
        data-handbook-menu
        aria-label="Open navigation"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16">
          <path
            d="M4 6h16M4 12h16M4 18h16"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </button>

      <a class="handbook-back" href="/categories/notes/" title="Back to notes">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" aria-hidden="true">
          <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span>Notes</span>
      </a>

      <span class="handbook-sep" aria-hidden="true">/</span>
      <a class="handbook-book" href={handbook.base}>{handbook.title}</a>
      {
        crumbs.map(crumb => (
          <>
            <span class="handbook-sep" aria-hidden="true">
              /
            </span>
            {crumb.href ? (
              <a class="handbook-crumb-link" href={crumb.href}>
                {crumb.label}
              </a>
            ) : (
              <span class="handbook-here">{crumb.label}</span>
            )}
          </>
        ))
      }

      <div class="handbook-bar-right">
        <a class="handbook-iconlink" href="/search" aria-label="Search">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="2"></circle>
            <path d="m16 16 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </a>
        <div class="themeset" role="radiogroup" aria-label="Colour theme">
          <button class="themeset-opt" type="button" role="radio" aria-checked="false" data-theme-choice="light" aria-label="Light">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="2"></circle>
              <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            </svg>
          </button>
          <button class="themeset-opt" type="button" role="radio" aria-checked="false" data-theme-choice="dark" aria-label="Dark">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M20 15A8.5 8.5 0 0 1 9 4a8.5 8.5 0 1 0 11 11Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
            </svg>
          </button>
          <button class="themeset-opt" type="button" role="radio" aria-checked="false" data-theme-choice="system" aria-label="Match system">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="2.5" y="4" width="19" height="13" rx="1.5" stroke="currentColor" stroke-width="2"></rect>
              <path d="M9 20.5h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <div class:list={["handbook-body", { "has-toc": hasToc }]}>
      <aside
        class="handbook-nav"
        transition:persist={`handbook-nav-${handbook.id}`}
        data-handbook-id={handbook.id}
        data-handbook-base={handbook.base}
        aria-label={`${handbook.title} navigation`}
      >
        <p class="handbook-nav-head">{navHeading}</p>
        <HandbookTree nodes={tree} />
      </aside>

      <main class="handbook-doc" id="main-content">
        <slot />
      </main>

      {
        hasToc && (
          <aside class="handbook-toc" aria-label="On this page">
            <TableOfContents {headings} />
          </aside>
        )
      }
    </div>

    <div class="handbook-backdrop" data-handbook-backdrop hidden></div>
  </div>
</Layout>

<style is:global>
  /* ===================== handbook documentation shell ===================== */
  .handbook {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background: var(--background);
    color: var(--foreground);
    font-family: var(--font-mono, monospace);
  }

  /* --- top bar --- */
  .handbook-bar {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 12px;
    background: var(--chrome);
    color: var(--chrome-ink);
    border-bottom: 1px solid var(--chrome-rule);
    font-size: 12.5px;
    white-space: nowrap;
  }
  .handbook-bar a {
    color: inherit;
    text-decoration: none;
  }
  .handbook-back {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px 3px 5px;
    border: 1px solid var(--chrome-rule);
    border-radius: 5px;
    color: var(--chrome-dim);
  }
  .handbook-back:hover {
    color: var(--chrome-ink);
    background: var(--chrome-hover);
    border-color: var(--chrome-hover);
  }
  .handbook-book {
    color: var(--chrome-accent);
    font-weight: 700;
  }
  .handbook-sep {
    color: var(--chrome-dim);
  }
  .handbook-crumb-link {
    color: var(--chrome-dim);
  }
  .handbook-crumb-link:hover {
    color: var(--chrome-ink);
  }
  .handbook-here {
    color: var(--chrome-ink);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .handbook-bar-right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .handbook-iconlink {
    color: var(--chrome-dim);
    display: inline-flex;
  }
  .handbook-iconlink:hover {
    color: var(--chrome-ink);
  }
  .handbook-menu {
    display: none;
    background: none;
    border: 0;
    color: var(--chrome-ink);
    cursor: pointer;
    padding: 4px;
    margin-left: -4px;
  }

  /* --- body grid --- */
  .handbook-body {
    display: grid;
    grid-template-columns: 288px minmax(0, 1fr);
    align-items: start;
    flex: 1;
  }
  .handbook-body.has-toc {
    grid-template-columns: 288px minmax(0, 1fr) 236px;
  }

  /* --- navigation tree --- */
  .handbook-nav {
    position: sticky;
    top: 44px;
    height: calc(100vh - 44px);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--chrome);
    color: var(--chrome-ink);
    border-right: 1px solid var(--chrome-rule);
    padding: 8px 0 40px;
  }
  .handbook-nav-head {
    padding: 6px 14px 10px;
    margin: 0;
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--chrome-dim);
  }
  .handbook-nav .tree,
  .handbook-nav .tree-children {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tree-item {
    margin: 0;
  }
  .tree-row {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    box-sizing: border-box;
    padding: 3px 12px 3px calc(10px + var(--depth, 0) * 13px);
    font: inherit;
    font-size: 12.5px;
    line-height: 1.35;
    text-align: left;
    text-decoration: none;
    color: var(--chrome-dim);
    background: none;
    border: 0;
    border-left: 2px solid transparent;
    cursor: pointer;
  }
  .tree-row:hover {
    background: var(--chrome-hover);
    color: var(--chrome-ink);
  }
  .tree-folder .tree-name {
    color: var(--chrome-ink);
    font-weight: 600;
  }
  .tree-caret {
    flex: none;
    width: 11px;
    height: 11px;
    color: var(--chrome-dim);
    transition: transform 0.12s ease;
    transform: rotate(90deg);
  }
  .tree-folder[aria-expanded="false"] .tree-caret {
    transform: rotate(0deg);
  }
  .tree-folder[aria-expanded="false"] + .tree-children {
    display: none;
  }
  .tree-dot {
    flex: none;
    width: 4px;
    height: 4px;
    margin: 0 3.5px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.45;
  }
  .tree-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tree-note.is-current {
    color: var(--chrome-accent);
    background: var(--chrome-hover);
    border-left-color: var(--chrome-accent);
  }
  .tree-note.is-current .tree-dot {
    opacity: 1;
  }

  /* --- document column --- */
  .handbook-doc {
    min-width: 0;
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
    padding: 26px 44px 96px;
    box-sizing: border-box;
  }
  .handbook-doc :is(h1, h2, h3, h4) {
    scroll-margin-top: 60px;
  }
  .handbook-crumb {
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0 0 10px;
  }
  .handbook-title {
    font-family: var(--font-display, var(--font-mono));
    font-size: clamp(1.55rem, 1.2rem + 1.4vw, 2rem);
    line-height: 1.15;
    margin: 0 0 18px;
    color: var(--foreground);
  }
  .handbook-intro {
    color: var(--soft);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* --- outline column --- */
  .handbook-toc {
    position: sticky;
    top: 44px;
    height: calc(100vh - 44px);
    overflow-y: auto;
    padding: 26px 16px 40px;
    border-left: 1px solid var(--rule);
    font-size: 12px;
  }

  /* --- mobile drawer --- */
  .handbook-backdrop {
    display: none;
  }
  @media (max-width: 1100px) {
    .handbook-body.has-toc {
      grid-template-columns: 288px minmax(0, 1fr);
    }
    .handbook-toc {
      display: none;
    }
  }
  @media (max-width: 820px) {
    .handbook-menu {
      display: inline-flex;
    }
    .handbook-body,
    .handbook-body.has-toc {
      grid-template-columns: minmax(0, 1fr);
    }
    .handbook-nav {
      position: fixed;
      top: 44px;
      left: 0;
      width: 284px;
      max-width: 84vw;
      z-index: 50;
      transform: translateX(-100%);
      transition: transform 0.18s ease;
    }
    .handbook[data-open] .handbook-nav {
      transform: none;
    }
    .handbook[data-open] .handbook-backdrop {
      display: block;
      position: fixed;
      inset: 44px 0 0 0;
      z-index: 45;
      background: rgba(0, 0, 0, 0.5);
    }
    .handbook-doc {
      padding: 20px 18px 80px;
    }
  }
</style>

<script>
  // Generic handbook navigation behaviour: highlight the current chapter,
  // expand its ancestors, remember which folders the reader collapsed and where
  // the sidebar was scrolled, and run the mobile drawer. State is namespaced by
  // the handbook id read off the nav element, so handbooks never collide. The
  // tree DOM persists across navigations (transition:persist), so folder wiring
  // is bound once; only the highlight is re-synced on every page load.

  function nav(): HTMLElement | null {
    return document.querySelector<HTMLElement>(".handbook-nav");
  }

  function readSet(key: string): Set<string> {
    try {
      return new Set(JSON.parse(localStorage.getItem(key) || "[]"));
    } catch {
      return new Set();
    }
  }
  function writeSet(key: string, set: Set<string>) {
    try {
      localStorage.setItem(key, JSON.stringify([...set]));
    } catch {
      /* private mode: session-only state */
    }
  }

  function currentSlug(base: string): string | null {
    const path = location.pathname.replace(/\/$/, "");
    if (!path.startsWith(base + "/")) return null;
    const rest = path.slice(base.length + 1);
    return rest.includes("/") ? null : decodeURIComponent(rest);
  }

  function setOpen(btn: Element, open: boolean) {
    btn.setAttribute("aria-expanded", open ? "true" : "false");
  }

  function syncTree() {
    const el = nav();
    if (!el) return;
    const id = el.dataset.handbookId || "handbook";
    const base = el.dataset.handbookBase || "";
    const collapsedKey = `handbook:${id}:collapsed`;
    const scrollKey = `handbook:${id}:sidebar-scroll`;

    // First encounter for this persisted tree: restore collapse + scroll state
    // and wire the folder toggles and scroll saver once.
    if (!el.dataset.wired) {
      el.dataset.wired = "1";

      const collapsed = readSet(collapsedKey);
      el.querySelectorAll<HTMLElement>(".tree-folder").forEach(btn => {
        if (collapsed.has(btn.dataset.handbookFolder || "")) setOpen(btn, false);
      });

      try {
        const y = Number(localStorage.getItem(scrollKey) || "0");
        if (y > 0) el.scrollTop = y;
      } catch {
        /* ignore */
      }

      el.addEventListener("click", event => {
        const btn = (event.target as HTMLElement).closest<HTMLElement>(
          ".tree-folder"
        );
        if (!btn || !el.contains(btn)) return;
        const open = btn.getAttribute("aria-expanded") !== "false";
        setOpen(btn, !open);
        const set = readSet(collapsedKey);
        const path = btn.dataset.handbookFolder || "";
        if (open) set.add(path);
        else set.delete(path);
        writeSet(collapsedKey, set);
      });

      let queued = false;
      el.addEventListener(
        "scroll",
        () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(() => {
            queued = false;
            try {
              localStorage.setItem(scrollKey, String(el.scrollTop));
            } catch {
              /* ignore */
            }
          });
        },
        { passive: true }
      );
    }

    // Highlight the current chapter and open every folder above it.
    el.querySelectorAll(".tree-note.is-current").forEach(node => {
      node.classList.remove("is-current");
      node.removeAttribute("aria-current");
    });

    const slug = currentSlug(base);
    if (!slug) return;
    const current = el.querySelector<HTMLElement>(
      `.tree-note[data-handbook-note="${CSS.escape(slug)}"]`
    );
    if (!current) return;
    current.classList.add("is-current");
    current.setAttribute("aria-current", "page");

    let node: HTMLElement | null = current;
    while (node && node !== el) {
      if (node.classList.contains("tree-children")) {
        const btn = node.previousElementSibling;
        if (btn && btn.classList.contains("tree-folder")) setOpen(btn, true);
      }
      node = node.parentElement;
    }
    current.scrollIntoView({ block: "nearest" });
  }

  function closeDrawer() {
    document.querySelector(".handbook")?.removeAttribute("data-open");
  }

  // Drawer controls are delegated on the document and bound once, since the
  // header re-renders on each navigation while these listeners outlive it.
  if (!(window as unknown as { __handbookDrawer?: boolean }).__handbookDrawer) {
    (window as unknown as { __handbookDrawer?: boolean }).__handbookDrawer =
      true;
    document.addEventListener("click", event => {
      const target = event.target as HTMLElement;
      if (target.closest("[data-handbook-menu]")) {
        document.querySelector(".handbook")?.toggleAttribute("data-open");
        return;
      }
      if (target.closest("[data-handbook-backdrop]")) closeDrawer();
      else if (target.closest(".handbook-nav a")) closeDrawer();
    });
  }

  syncTree();
  document.addEventListener("astro:page-load", syncTree);
</script>
