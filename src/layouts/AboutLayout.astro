---
import type { MarkdownLayoutProps } from "astro";
import Pane from "./Pane.astro";

type Props = MarkdownLayoutProps<{ title: string }>;

const { frontmatter } = Astro.props;
---

<Pane title={frontmatter.title.toLowerCase()} path={[{ label: "about" }]}>
  <div class="pane-read">
    <section id="about" class="app-prose max-w-none prose-img:border-0">
      <slot />
    </section>
  </div>
</Pane>
