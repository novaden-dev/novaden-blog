---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Shell from "@/layouts/Shell.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import {
  getCollections,
  getMemberships,
  neighbours,
} from "@/utils/collections";
import { getPath } from "@/utils/getPath";
import { postHref } from "@/utils/handbook";
import { CATEGORIES } from "@/utils/categories";
import { slugifyStr } from "@/utils/slugify";
import { getReadingTime } from "@/utils/readingTime";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
} = post.data;

const { Content, headings } = await render(post);

let ogImageUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src; // Local asset
}

// Use dynamic OG image if enabled and no remote|local ogImage
if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath)}/index.png`;
}

// Resolve OG image URL (or fallback to SITE.ogImage / default `og.png`)
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
};

/* ========== "You are here": position in a collection ========== */

// A post can sit in any number of collections, so the page cannot ask which
// one it is "in". It asks which placements point at it.
//
// With exactly one reading placement there is a single position and the rail
// shows the sequence with this one marked. With several, the page stays
// neutral and lists them instead: a direct visit never gets a reading order
// invented for it.
const allCollections = await getCollections();
const memberships = getMemberships(post.id, allCollections);
const stepMemberships = memberships.filter(entry => entry.step !== null);
const active = stepMemberships.length === 1 ? stepMemberships[0] : undefined;

// "Homelab v1.2 – The Supply Chain" reads better split into a version and a
// title, which is also how the sequence is actually navigated.
const steps = (active?.collection.steps ?? []).map(item => {
  const label = item.placement.label ?? item.post.data.title;
  const match = label.match(/^.*?\s(v[\d.]+)\s*[—–-]\s*(.+)$/);
  return {
    href: postHref(item.post),
    n: match?.[1] ?? String(item.step),
    title: match?.[2] ?? label,
    here: item.placement.id === active?.placement.id,
  };
});
const here = steps.find(step => step.here);
// Collections this post appears in that the rail is not already showing.
// This is what keeps a shared item honest: it says where else it is used
// without pretending any of them is the reader's current path.
const alsoIn = memberships.filter(
  entry => entry.collection.id !== active?.collection.id
);

const sequence = active
  ? neighbours(active.collection, active.placement.id)
  : undefined;

/* ========== Previous / next ========== */

// Inside a collection, "previous" and "next" mean the reading order — the same
// order the rail and the step numbering already show. A post read on its own
// falls back to the archive.
//
// `posts` arrives newest-first, so the *older* neighbour sits at the higher
// index. Walking that array as though it ran forwards is what put the older
// post under "next" and the newer one under "previous".
const toLink = (entry: CollectionEntry<"blog"> | undefined) =>
  entry ? { title: entry.data.title, href: postHref(entry) } : undefined;

const currentPostIndex = posts.findIndex(entry => entry.id === post.id);

const prevPost = toLink(
  sequence
    ? sequence.prev?.post
    : currentPostIndex >= 0
      ? posts[currentPostIndex + 1]
      : undefined
);

const nextPost = toLink(
  sequence
    ? sequence.next?.post
    : currentPostIndex > 0
      ? posts[currentPostIndex - 1]
      : undefined
);

const kindLabel = (
  CATEGORIES[post.data.category]?.label ?? post.data.category
).toLowerCase();

const path = [
  { label: kindLabel, href: `/categories/${post.data.category}/` },
  ...(active
    ? [
        {
          label: active.collection.id,
          href: `/collections/${active.collection.id}/`,
        },
      ]
    : []),
  { label: post.id },
];
---

<Layout {...layoutProps}>
  <Shell {path} place={post.data.category}>
    <div class="read" data-pagefind-body data-kind={post.data.category}>
      <article>
        <p class="read-kind">
          <span class="k">{kindLabel}</span>
          {
            active && here && (
              <span>
                {active.collection.id} · {here.n}
              </span>
            )
          }
          <span>{getReadingTime(post)} min read</span>
          <Datetime {pubDatetime} {modDatetime} {timezone} />
        </p>

        <h1
          transition:name={slugifyStr(title.replaceAll(".", "-"))}
          class="read-h1"
        >
          {title}
        </h1>

        {description && <p class="read-dek">{description}</p>}

        {
          /* No byline: one person writes everything here, so naming them on
            every post is noise. The author still ships in the metadata, where
            a machine reads it. */
        }
        <div class="read-by">
          {
            active && (
              <span>
                step {active.step} of {steps.length}
              </span>
            )
          }
          <EditPost {hideEditPost} {post} class="max-sm:hidden" />
        </div>

        <div id="article" class="app-prose read-body">
          <Content />
        </div>

        <div class="read-foot" data-pagefind-ignore>
          <ul class="tagrow">
            {
              tags.map(tag => (
                <li>
                  <a href={`/tags/${slugifyStr(tag)}/`}>{tag}</a>
                </li>
              ))
            }
          </ul>

          <div class="postnav">
            {
              prevPost && (
                <a
                  href={prevPost.href}
                  aria-label={`Previous: ${prevPost.title}`}
                >
                  <IconChevronLeft class="inline-block size-3.5 flex-none rtl:rotate-180" />
                  <b class="min-w-0">{prevPost.title}</b>
                </a>
              )
            }
            {
              nextPost && (
                <a
                  href={nextPost.href}
                  aria-label={`Next: ${nextPost.title}`}
                  class="justify-end text-end sm:col-start-2"
                >
                  <b class="min-w-0">{nextPost.title}</b>
                  <IconChevronRight class="inline-block size-3.5 flex-none rtl:rotate-180" />
                </a>
              )
            }
          </div>
        </div>
      </article>

      <aside class="read-rail" data-pagefind-ignore>
        {
          /* The rail runs from the narrowest scope outwards: this page,
            then the sequence it sits in, then everywhere else it is used.
            Contents leads because it is the only live control here — the
            scrollspy tracks it while you read, and a long collection would
            otherwise push it past the fold. */
        }
        <TableOfContents {headings} />

        {
          steps.length > 1 && (
            <nav
              aria-label={`Contents of ${active?.collection.entry.data.title}`}
            >
              <p class="rail-label">You are here</p>
              {steps.map(step =>
                step.here ? (
                  <div class="rail-step is-here" aria-current="page">
                    <span class="n">{step.n}</span>
                    <span>{step.title}</span>
                  </div>
                ) : (
                  <a class="rail-step" href={step.href}>
                    <span class="n">{step.n}</span>
                    <span>{step.title}</span>
                  </a>
                )
              )}
            </nav>
          )
        }

        {
          alsoIn.length > 0 && (
            <nav class="rail-also" aria-label="Collections including this post">
              <p class="rail-label">{active ? "Also in" : "Part of"}</p>
              {alsoIn.map(entry => (
                <a
                  class="rail-step"
                  href={`/collections/${entry.collection.id}/`}
                >
                  <span class="n">{entry.step ?? "+"}</span>
                  <span>
                    {entry.collection.entry.data.title}
                    {entry.placement.note && (
                      <em class="rail-why">{entry.placement.note}</em>
                    )}
                  </span>
                </a>
              ))}
            </nav>
          )
        }
      </aside>
    </div>
  </Shell>
</Layout>

<script is:inline data-astro-rerun>
  /** Create a progress indicator
   *  at the top */
  function createProgressBar() {
    // Create the main container div
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-10 h-1 w-full bg-background";

    // Create the progress bar div
    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-accent";
    progressBar.id = "myBar";

    // Append the progress bar to the progress container
    progressContainer.appendChild(progressBar);

    // Append the progress container to the document body or any other desired parent element
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  /** Update the progress bar
   *  when user scrolls */
  function updateScrollProgress() {
    document.addEventListener("scroll", () => {
      const winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      if (document) {
        const myBar = document.getElementById("myBar");
        if (myBar) {
          myBar.style.width = scrolled + "%";
        }
      }
    });
  }
  updateScrollProgress();

  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("h2, h3, h4, h5, h6")
    );
    for (const heading of headings) {
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ms-2 no-underline opacity-75 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100";
      link.href = "#" + heading.id;

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Attaches copy buttons to code blocks in the document,
   * allowing users to copy code easily. */
  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const codeBlock of codeBlocks) {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      // Check if --file-name-offset custom property exists
      const computedStyle = getComputedStyle(codeBlock);
      const hasFileNameOffset =
        computedStyle.getPropertyValue("--file-name-offset").trim() !== "";

      // Determine the top positioning class
      const topClass = hasFileNameOffset ? "top-(--file-name-offset)" : "top-2";

      const copyButton = document.createElement("button");
      copyButton.className = `copy-code absolute end-2 ${topClass} rounded-md border border-border bg-card px-2 py-1 text-xs leading-4 text-foreground font-medium hover:text-accent`;
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      // wrap codebock with relative parent element
      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      // visual feedback that task is completed
      button.innerText = "Copied";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  /** Network diagrams and screenshots are unreadable at column width, so an
   *  image opens full-screen on click. */
  function attachImageZoom() {
    const images = Array.from(document.querySelectorAll(".read-body img"));
    if (images.length === 0) return;

    let overlay = document.querySelector(".zoom");

    if (!overlay) {
      overlay = document.createElement("div");
      overlay.className = "zoom";
      overlay.hidden = true;
      overlay.innerHTML = '<img alt="" />';
      document.body.appendChild(overlay);
      overlay.addEventListener("click", close);
    }

    function close() {
      overlay.hidden = true;
      document.documentElement.style.overflow = "";
    }

    // The body is replaced on a view transition, so the overlay is rebuilt each
    // time; the document-level key handler is bound once.
    if (!window.__zoomBound) {
      window.__zoomBound = true;
      document.addEventListener("keydown", event => {
        if (event.key === "Escape") {
          const current = document.querySelector(".zoom");
          if (current && !current.hidden) {
            current.hidden = true;
            document.documentElement.style.overflow = "";
          }
        }
      });
    }

    for (const image of images) {
      image.classList.add("zoomable");
      image.addEventListener("click", () => {
        const full = overlay.querySelector("img");
        full.src = image.currentSrc || image.src;
        full.alt = image.alt || "";
        overlay.hidden = false;
        document.documentElement.style.overflow = "hidden";
      });
    }
  }
  attachImageZoom();

  /* Go to page start after page swap */
  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  );
</script>
