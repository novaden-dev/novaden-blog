---
import type { MarkdownHeading } from "astro";

type Props = {
  headings: MarkdownHeading[];
};

const { headings } = Astro.props;

// Only surface section/subsection headings; deeper levels add noise.
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{
  tocHeadings.length > 1 && (
    <nav id="toc" aria-label="Table of contents" data-pagefind-ignore>
      <p class="rail-label">Contents</p>
      <ul class="toc-list">
        {tocHeadings.map(heading => (
          <li class:list={[{ "is-sub": heading.depth === 3 }]}>
            <a
              href={"#" + heading.slug}
              data-toc-link={heading.slug}
              class="toc-link"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script is:inline data-astro-rerun>
  function initToc() {
    const links = Array.from(document.querySelectorAll("[data-toc-link]"));
    if (links.length === 0) return;

    const linkBySlug = new Map(
      links.map(link => [link.getAttribute("data-toc-link"), link])
    );

    // A semantic class, styled in shell.css — Tailwind utilities named only
    // inside a script are not guaranteed to be generated.
    const setActive = slug => {
      for (const link of links) {
        link.classList.toggle(
          "is-current",
          link.getAttribute("data-toc-link") === slug
        );
      }
    };

    const headings = Array.from(linkBySlug.keys())
      .map(slug => document.getElementById(slug))
      .filter(Boolean);

    const observer = new IntersectionObserver(
      entries => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(entry.target.id);
        }
      },
      { rootMargin: "0px 0px -75% 0px", threshold: 1 }
    );

    for (const heading of headings) observer.observe(heading);
  }
  initToc();
  document.addEventListener("astro:after-swap", initToc);
</script>
