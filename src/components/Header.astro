---
// Site header — the same on every page, including the home page.
// Keeps `id="theme-btn"` so scripts/theme.ts wires up the toggle.
import { SITE } from "@/config";
import { OSCP } from "@/constants";

const { pathname } = Astro.url;

// A link is active when the current path sits under it: /posts/2 lights up
// "Posts", /categories/notes/3 lights up "Notes".
const isActive = (href: string) => {
  const strip = (p: string) => p.replace(/\/+$/, "");
  return (
    strip(pathname) === strip(href) || pathname.startsWith(`${strip(href)}/`)
  );
};

const links = [
  { href: "/posts", label: "Posts" },
  { href: "/projects", label: "Projects" },
  { href: "/categories/notes", label: "Notes" },
  { href: "/series/homelab", label: "Homelab" },
  { href: "/about", label: "About" },
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent transition-all focus:top-4"
>
  Skip to content
</a>

<header class="l-nav">
  <div class="l-wrap l-nav-inner">
    <a
      href="/"
      class="flex items-center gap-2 font-bold"
      aria-label={SITE.title}
    >
      <svg
        width="26"
        height="26"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
        style="color: var(--accent)"
      >
        <path
          d="M12 1.5 13.9 9c.15.6.5 1 1.1 1.15L22.5 12l-7.5 1.85c-.6.15-.95.55-1.1 1.15L12 22.5l-1.9-7.5c-.15-.6-.5-1-1.1-1.15L1.5 12l7.5-1.85c.6-.15.95-.55 1.1-1.15L12 1.5Z"
          fill="currentColor"
          stroke="var(--line)"
          stroke-width="1.5"
          stroke-linejoin="round"></path>
      </svg>
      <span class="text-lg tracking-tight">{SITE.title}</span>
    </a>

    <nav class="l-nav-links" aria-label="Primary">
      {
        links.map(link => (
          <a
            href={link.href}
            class:list={{ "is-active": isActive(link.href) }}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a href={OSCP.url} target="_blank" rel="noopener">
        OSCP <span aria-hidden="true" style="color: var(--soft)">↗</span>
      </a>

      <a
        href="/search"
        class:list={["l-icon-btn", { "text-accent": isActive("/search") }]}
        title="Search"
        aria-label="Search"
      >
        <svg
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"
          ></circle>
          <path
            d="m20 20-3.5-3.5"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </a>

      {
        SITE.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="l-icon-btn"
            title="Toggles light & dark"
            aria-label="auto"
            aria-live="polite"
          >
            <svg
              class="icon-moon"
              width="19"
              height="19"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"
                stroke="currentColor"
                stroke-width="2"
                stroke-linejoin="round"
              />
            </svg>
            <svg
              class="icon-sun"
              width="19"
              height="19"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <circle
                cx="12"
                cy="12"
                r="4.2"
                stroke="currentColor"
                stroke-width="2"
              />
              <path
                d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
            </svg>
          </button>
        )
      }
    </nav>
  </div>
</header>
