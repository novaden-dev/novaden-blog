---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import { CATEGORIES } from "@/utils/categories";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, category, ...props } = data;
---

<li>
  <a href={getPath(id, filePath)} class="row-post">
    <div>
      <Heading
        style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
      >
        {title}
      </Heading>
      <p class="mt-1">{description}</p>
    </div>
    <div class="row-meta">
      <span class="row-kind">{CATEGORIES[category]?.label ?? category}</span>
      <Datetime {...props} />
    </div>
  </a>
</li>
