---
type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;
---

<li>
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class:list={["chip", { "text-base": size === "lg" }]}
  >
    <span aria-hidden="true" class="text-soft">#</span>
    {tagName}
  </a>
</li>
