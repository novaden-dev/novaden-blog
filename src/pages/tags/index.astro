---
import { getCollection } from "astro:content";
import Pane from "@/layouts/Pane.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";

const posts = await getCollection("blog");

const tags = getUniqueTags(posts)
  .map(({ tag, tagName }) => ({
    tag,
    tagName,
    count: getPostsByTag(posts, tag).length,
  }))
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag));
---

<Pane
  title="tags"
  desc="Topic, not shape. A post has one category and as many tags as it needs."
  stat={`${tags.length} tags`}
  path={[{ label: "tags" }]}
>
  <div class="cols" aria-hidden="true">
    <span>name</span><span class="r">items</span>
  </div>
  <div class="dir-grid">
    {
      tags.map(({ tag, tagName, count }) => (
        <a class="dir" href={`/tags/${tag}/`}>
          <span class="dir-name">{tagName.toLowerCase()}</span>
          <span class="dir-count">{count}</span>
        </a>
      ))
    }
  </div>
</Pane>
