---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Pane from "@/layouts/Pane.astro";
import FileList from "@/components/FileList.astro";
import Pagination from "@/components/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { SITE } from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("blog");
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);
    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage,
    });
  });
}) satisfies GetStaticPaths;

const { tag } = Astro.params;
const { page, tagName } = Astro.props;
---

<Pane
  title={String(tagName).toLowerCase()}
  desc={`Everything tagged "${tagName}".`}
  stat={`${page.total} items`}
  path={[{ label: "tags", href: "/tags/" }, { label: String(tag) }]}
>
  <FileList posts={page.data} filter={page.lastPage === 1} />
  <Pagination {page} />
</Pane>
