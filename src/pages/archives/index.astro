---
import { getCollection } from "astro:content";
import Pane from "@/layouts/Pane.astro";
import FileList from "@/components/FileList.astro";
import getPostsByGroupCondition from "@/utils/getPostsByGroupCondition";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

// Redirect to 404 page if `showArchives` config is false
if (!SITE.showArchives) {
  return Astro.redirect("/404");
}

const posts = await getCollection("blog", ({ data }) => !data.draft);

const years = Object.entries(
  getPostsByGroupCondition(posts, post => post.data.pubDatetime.getFullYear())
)
  .sort(([a], [b]) => Number(b) - Number(a))
  .map(([year, group]) => ({ year, posts: getSortedPosts(group) }));
---

<Pane
  title="archive"
  desc="Everything by year, oldest work included."
  stat={`${posts.length} items`}
  path={[{ label: "archives" }]}
>
  {
    years.map(({ year, posts: yearPosts }) => (
      <section>
        <div class="year-head">
          <span class="year">{year}</span>
          <span class="year-count">{yearPosts.length} items</span>
        </div>
        <FileList posts={yearPosts} />
      </section>
    ))
  }
</Pane>
