---
import { getCollection, render } from "astro:content";
import Pane from "@/layouts/Pane.astro";
import projectFilter from "@/utils/projectFilter";

const projects = (await getCollection("projects", projectFilter)).sort(
  (a, b) => a.data.order - b.data.order
);

// With nothing public there is no page: a body-less response is never written
// to dist, so production has no empty "0 apps" listing and no sitemap entry.
if (projects.length === 0) return new Response(null, { status: 404 });

const rendered = await Promise.all(
  projects.map(async project => ({
    ...project,
    Content: (await render(project)).Content,
  }))
);
---

<Pane
  title="apps"
  desc="Small things I built because the alternative annoyed me. Open source, still moving."
  stat={`${projects.length} apps`}
  path={[{ label: "apps" }]}
  place="apps"
  head="Projects"
>
  <div class="projects">
    {
      rendered.map(project => (
        <article class="project">
          <div class="project-head">
            <h2 class="project-name">{project.data.name}</h2>
            <span class={`state state-${project.data.status}`}>
              {project.data.status}
            </span>
          </div>

          <p class="project-tag">{project.data.tagline}</p>

          <div class="project-body">
            <project.Content />
          </div>

          <div class="project-meta">
            {project.data.stack.map(tech => (
              <span class="tech">{tech}</span>
            ))}
            <a href={project.data.repo} target="_blank" rel="noopener">
              source ↗
            </a>
            {project.data.releases && (
              <a href={project.data.releases} target="_blank" rel="noopener">
                download ↗
              </a>
            )}
            {project.data.post && (
              <a href={`/posts/${project.data.post}`}>how it got built →</a>
            )}
          </div>
        </article>
      ))
    }
  </div>
</Pane>
