---
import { getCollection } from "astro:content";
import Pane from "@/layouts/Pane.astro";
import getUniqueSeries from "@/utils/getUniqueSeries";

const posts = await getCollection("blog");
const seriesList = getUniqueSeries(posts);
---

<Pane
  title="series"
  desc="Multi-part runs, ordered from the beginning."
  stat={`${seriesList.length} series`}
  path={[{ label: "series" }]}
>
  {
    seriesList.length === 0 ? (
      <p class="empty">no series yet.</p>
    ) : (
      <>
        <div class="cols" aria-hidden="true">
          <span>name</span>
          <span class="r">parts</span>
        </div>
        {seriesList.map(({ series, seriesName, count }) => (
          <a class="dir" href={`/series/${series}/`} data-kind="series">
            <span class="dir-name">
              <span class="file-dot" aria-hidden="true" />
              {seriesName.toLowerCase()}
            </span>
            <span class="dir-count">{count}</span>
          </a>
        ))}
      </>
    )
  }
</Pane>
