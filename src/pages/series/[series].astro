---
import { getCollection } from "astro:content";
import Pane from "@/layouts/Pane.astro";
import FileList from "@/components/FileList.astro";
import getUniqueSeries from "@/utils/getUniqueSeries";
import getPostsBySeries from "@/utils/getPostsBySeries";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const seriesList = getUniqueSeries(posts);

  return seriesList.map(({ series, seriesName }) => ({
    params: { series },
    props: { seriesName },
  }));
}

const { series } = Astro.params;
const { seriesName } = Astro.props;

const posts = await getCollection("blog");
const seriesPosts = getPostsBySeries(posts, series);
---

<Pane
  title={String(seriesName).toLowerCase()}
  desc="A sequence. Read it in order, or drop in anywhere — every part links back."
  stat={`${seriesPosts.length} parts, in order`}
  path={[{ label: "series", href: "/series/" }, { label: String(series) }]}
  place={String(series)}
>
  <FileList posts={seriesPosts} numbered />
</Pane>
