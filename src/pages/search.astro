---
import "@pagefind/default-ui/css/ui.css";
import Pane from "@/layouts/Pane.astro";
import { SITE } from "@/config";

const backUrl = SITE.showBackButton ? `${Astro.url.pathname}` : "/";
---

<Pane
  title="search"
  desc="Full text, across every post. For jumping by title instead, press / anywhere."
  path={[{ label: "search" }]}
>
  <div class="pane-read">
    <div id="pagefind-search" transition:persist data-backurl={backUrl}></div>
  </div>
</Pane>

<script>
  function initSearch() {
    const pageFindSearch: HTMLElement | null =
      document.querySelector("#pagefind-search");

    if (!pageFindSearch) return;

    const params = new URLSearchParams(window.location.search);

    function note(html: string) {
      const box = document.createElement("div");
      box.className = "search-note";
      box.innerHTML = html;
      pageFindSearch?.prepend(box);
    }

    // requestIdleCallback never fires while the tab is hidden and can be
    // starved on a busy main thread. Without a deadline the page just stays an
    // empty box, which is indistinguishable from search being broken.
    const onIdle = (cb: () => void) =>
      window.requestIdleCallback
        ? window.requestIdleCallback(cb, { timeout: 1500 })
        : setTimeout(cb, 1);

    onIdle(async () => {
      let PagefindUI;
      try {
        // @ts-expect-error — Missing types for @pagefind/default-ui package.
        ({ PagefindUI } = await import("@pagefind/default-ui"));
      } catch (error) {
        console.error("[search] could not load the Pagefind UI", error);
        note(
          "<strong>Search is unavailable.</strong> The search bundle failed to load."
        );
        return;
      }

      if (import.meta.env.DEV) {
        note(
          "<strong>Dev mode.</strong> The index is written by a full build, so results here are from the last one, or absent if you have never run it. <code>pnpm run build</code>"
        );
      }

      // Init pagefind ui
      let search;
      try {
        search = new PagefindUI({
          element: "#pagefind-search",
          showImages: false,
          showSubResults: true,
          processTerm: function (term: string) {
            params.set("q", term); // Update the `q` parameter in the URL
            history.replaceState(history.state, "", "?" + params.toString()); // Push the new URL without reloading

            const backUrl = pageFindSearch?.dataset?.backurl;
            sessionStorage.setItem(
              "backUrl",
              backUrl + "?" + params.toString()
            );

            return term;
          },
        });
      } catch (error) {
        console.error("[search] could not start Pagefind", error);
        note(
          "<strong>Search is unavailable.</strong> No index was found. It is generated by <code>pnpm run build</code>."
        );
        return;
      }

      // If search param exists (eg: search?q=astro), trigger search
      const query = params.get("q");
      if (query) {
        search.triggerSearch(query);
      }

      // Reset search param if search input is cleared
      const searchInput = document.querySelector(".pagefind-ui__search-input");
      const clearButton = document.querySelector(".pagefind-ui__search-clear");
      searchInput?.addEventListener("input", resetSearchParam);
      clearButton?.addEventListener("click", resetSearchParam);

      function resetSearchParam(e: Event) {
        if ((e.target as HTMLInputElement)?.value.trim() === "") {
          history.replaceState(history.state, "", window.location.pathname);
        }
      }
    });
  }

  document.addEventListener("astro:after-swap", () => {
    const pagefindSearch = document.querySelector("#pagefind-search");

    // if pagefind search form already exists, don't initialize search component
    if (pagefindSearch && pagefindSearch.querySelector("form")) return;

    initSearch();
  });
  initSearch();
</script>

<style is:global>
  /* Whatever goes wrong, the page says so rather than rendering an empty box. */
  .search-note {
    margin-bottom: 1rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--rule);
    border-inline-start: 2px solid var(--accent);
    border-radius: 3px;
    background: var(--sheet);
    font-family: var(--font-app);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--soft);
  }

  .search-note code {
    color: var(--foreground);
  }

  #pagefind-search {
    --pagefind-ui-font: var(--font-app);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--background);
    --pagefind-ui-border: var(--rule);
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-tag: var(--sheet);
    --pagefind-ui-border-radius: 3px;
    --pagefind-ui-border-width: 1px;

    form::before {
      background-color: var(--soft);
    }

    input {
      font-weight: 400;
      font-size: 0.95rem;
      border: 1px solid var(--rule);
      background: var(--sheet);
    }

    input:focus-visible {
      outline: 1px solid var(--accent);
    }

    .pagefind-ui__result-title a {
      color: var(--foreground);
      font-weight: 500;
    }

    .pagefind-ui__result-title a:hover {
      color: var(--accent);
    }

    .pagefind-ui__result-excerpt {
      font-family: var(--font-read);
    }

    .pagefind-ui__result:last-of-type {
      border-bottom: 0;
    }

    .pagefind-ui__result-nested .pagefind-ui__result-link:before {
      font-family: system-ui;
    }

    /* The browser's default <mark> is a yellow that belongs to no palette. */
    mark {
      background: color-mix(in oklab, var(--accent) 30%, transparent);
      color: var(--foreground);
      border-radius: 2px;
      padding: 0 0.15em;
    }

    /* Clear is chrome inside the field, not a raised button sitting on top. */
    .pagefind-ui__search-clear {
      background: transparent;
      color: var(--soft);
      font-size: 0.72rem;
      padding-inline: 0.75rem;
    }

    .pagefind-ui__search-clear:hover {
      background: transparent;
      color: var(--accent);
    }

    /* Skeletons for results whose data has not arrived yet. Pagefind paints
       these with the text colour at 10% opacity, which reads as a stuck grey
       slab; a rule-coloured bar reads as what it is. */
    .pagefind-ui__loading {
      background-color: var(--rule);
      opacity: 1;
    }
  }
</style>
