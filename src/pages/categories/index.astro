---
import { getCollection } from "astro:content";
import Pane from "@/layouts/Pane.astro";
import getUniqueCategories from "@/utils/getUniqueCategories";

const posts = await getCollection("blog");
const categories = getUniqueCategories(posts);
---

<Pane
  title="categories"
  desc="Split by shape, not by subject: notes get looked up, journals get read once. The same topic can live in both."
  stat={`${categories.length} kinds`}
  path={[{ label: "categories" }]}
>
  <div class="cols" aria-hidden="true">
    <span>name</span><span class="r">items</span>
  </div>
  {
    categories.map(({ category, label, description, count }) => (
      <a class="dir" href={`/categories/${category}/`} data-kind={category}>
        <span class="dir-name">
          <span class="file-dot" aria-hidden="true" />
          {label.toLowerCase()}
        </span>
        <span class="dir-count">{count}</span>
        <span class="dir-desc">{description}</span>
      </a>
    ))
  }
</Pane>
