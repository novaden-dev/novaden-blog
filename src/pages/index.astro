---
import { getCollection } from "astro:content";
import postFilter from "@/utils/postFilter";
import Pane from "@/layouts/Pane.astro";
import FileList from "@/components/FileList.astro";
import getSortedPosts from "@/utils/getSortedPosts";

// The front door is the index. You land inside the workspace looking at
// everything in it — but pinned items float to the top, so someone arriving
// cold has three places to start instead of fifty-three.

const posts = await getCollection("blog", postFilter);
const sorted = getSortedPosts(posts);

const pinned = sorted.filter(post => post.data.featured);
const rest = sorted.filter(post => !post.data.featured);

const description =
  "Security notes, small apps, and a homelab build log. Some of it is polished. Most of it is me finding out in public.";
---

<Pane
  title="everything"
  desc={description}
  stat={`${sorted.length} items`}
  place="all"
  head="notes, apps, and a homelab"
>
  <FileList
    filter
    groups={[
      ...(pinned.length > 0
        ? [
            {
              label: "pinned",
              note: `if you only read ${pinned.length === 1 ? "one" : pinned.length === 2 ? "two" : "three"}`,
              posts: pinned,
              star: true,
            },
          ]
        : []),
      { label: "everything", note: "newest first", posts: rest },
    ]}
  />
</Pane>
